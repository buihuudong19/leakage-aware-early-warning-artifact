# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Raw data (download from Kaggle, see data/README.md)
data/raw/*
!data/raw/.gitkeep

# Logs, large and intermediate outputs (regenerated by the pipeline). outputs/tables, outputs/figures and
# outputs/manifest.json are kept as the record of the reported run.
outputs/logs/
outputs/data/
outputs/robustness/
outputs_extra/logs/
# restart files of tools/sample_variants.py (the combined sample_*_rq2_window_metrics.csv are kept)
outputs_extra/tables/*_part_*.csv
*.pkl

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Earlier outputs moved aside before a full run (run_pipeline.bat / run_pipeline.sh)
_archive/
